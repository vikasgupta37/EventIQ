DATABASE_URL="postgresql://eventiq:eventiq_local_only@127.0.0.1:54329/eventiq_utf8?schema=public"
# Optional hosted non-pooled URL used only by build:vercel for migrations.
DIRECT_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Local demo only. Must be false on Vercel.
DEMO_MODE=true
APP_ORIGIN=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
# Set all three and DEMO_MODE=false to enable Google sign-in locally.
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
