# Public demo: browser-only persistence, no sign-in or database connection.
NEXT_PUBLIC_STORAGE_MODE=browser
APP_ORIGIN=http://127.0.0.1:3000
# Optional server-side AI. Never use NEXT_PUBLIC_ for a secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Optional database edition only: change NEXT_PUBLIC_STORAGE_MODE to database.
DATABASE_URL="postgresql://eventiq:eventiq_local_only@127.0.0.1:54329/eventiq_utf8?schema=public"
DIRECT_URL=
# Demo identity is local-only in the database edition.
DEMO_MODE=true
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
