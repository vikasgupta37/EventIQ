{
  "name": "eventiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/api.test.ts --exclude tests/management.test.ts --exclude tests/rate-limit.test.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:db": "vitest run --config vitest.database.config.ts",
    "check:submission": "node scripts/check-submission.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:submission"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
